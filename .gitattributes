# 换行与编码：避免 String.raw / 正则里的 \r?\n 被误改
* text=auto
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# PowerShell 脚本保留 CRLF（避免 ParserError）
*.ps1 text eol=crlf
# 二进制不参与换行转换
*.png binary
*.ico binary
*.icns binary